# chain constants (CC3 testnet). The two RPC URLs are handed to the browser by GET /state and pinned in the
# CSP header: use public endpoints, never a URL that carries an API key.
SOURCE_CHAIN_KEY=1
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# keys & deployments
CREDITCOIN_WALLET_PRIVATE_KEY=0x
ROUTER_ADDRESS=0x
CUSTODY_ROUTER_ADDRESS=0x
ESCROW_ADDRESS=0x
USDC_ADDRESS=0x
ASSET_ADDRESS=0x
BUYER=            # demo.sh order: the buyer's address — must differ from your own (createOrder rejects self-dealing)
# optional
START_BLOCK=0
BATCH_WAIT=      # default: settle each payment as soon as it is attested (~10 min). Set to 1 to hold a window until it is full (10 tx) or ~1000 blocks old (~3h20): cheaper per installment, hours slower
CUSTODY_WINDOW=240   # Creditcoin blocks after the order closed (Completed or Defaulted) before an unresolved custody bond reverts to the seller
